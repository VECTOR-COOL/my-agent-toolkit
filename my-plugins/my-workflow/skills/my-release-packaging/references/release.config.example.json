{
  "name": "my-project",
  "version": { "file": "core/include.php", "regex": "define\\(\\s*'_VERSION'\\s*,\\s*'([^']+)'\\s*\\)" },
  "lint": ["node", "scripts/lint.mjs"],
  "forbiddenExtra": [
    "(^|/)acount\\.json$",
    "(^|/)(sys|db)\\.config\\.inc\\.php$",
    "^(docs|scripts|profiles|tests)(/|$)",
    "^log/(?!\\.gitkeep$).+",
    "^content/(user_files|temp)/(?!\\.gitkeep$).+"
  ],
  "placeholders": ["img", "log", "content/user_files", "content/temp"],
  "outDir": "dist"
}
